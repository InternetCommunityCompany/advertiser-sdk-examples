{
  "name": "nextjs-typescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack --port 3001",
    "sdk:build": "bun run --cwd ../../specify-sdks build --filter=@specify-sh/advertiser-sdk",
    "types": "next typegen && tsc --noEmit",
    "build": "next build --webpack",
    "start": "next start --port 3001"
  },
  "dependencies": {
    "@specify-sh/advertiser-sdk": "file:../../specify-sdks/packages/advertiser-sdk",
    "next": "16.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3"
  }
}
